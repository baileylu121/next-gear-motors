<article class="mx-auto max-w-6xl px-4 py-16">
  <header data-animate-down class="text-center">
    <p class="font-sans text-xs font-bold uppercase tracking-[0.18em] text-raw-sienna-700">
      Get in touch
    </p>
    <h1 class="mt-3 font-display text-3xl md:text-4xl font-bold uppercase text-zinc-950">
      Contact Information
    </h1>
    <p class="mt-3 font-sans text-zinc-600">
      Call, message, or visit. Sourcing and trade-ins welcome.
    </p>
  </header>

  <div
    data-animate-down
    class="mx-auto mt-10 max-w-2xl rounded-2xl border border-zinc-200 bg-white p-8 shadow-card"
  >
    <.list>
      <:title>
        Contact Information
      </:title>
      <:item title="Instagram">
        <a
          href="https://www.instagram.com/nextgearmotors/"
          class="text-raw-sienna-700 font-semibold hover:underline"
        >
          @nextgearmotors
        </a>
      </:item>
      <:item title="Phone Number">
        <a
          href="tel:+3530857655578"
          class="text-raw-sienna-700 font-semibold hover:underline"
        >085 765 5578</a>
      </:item>
      <:item title="Email Address">
        <a
          href="mailto:nextgearmotors1@gmail.com"
          class="text-raw-sienna-700 font-semibold hover:underline"
        >
          nextgearmotors1@gmail.com
        </a>
      </:item>
      <:item title="TikTok">
        <a
          href="https://www.tiktok.com/@nextgearmotors25"
          class="text-raw-sienna-700 font-semibold hover:underline"
        >
          @nextgearmotors25
        </a>
      </:item>
    </.list>
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <a
        href="tel:+3530857655578"
        class="flex-1 inline-flex items-center justify-center gap-2 rounded-2xl py-2 px-3 min-h-11 text-sm font-semibold leading-6 font-sans focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-raw-sienna-600 bg-linear-to-r from-raw-sienna-500 to-raw-sienna-700 text-white hover:brightness-110 hover:shadow-lift"
      >
        <.icon name="hero-phone" class="h-4 w-4" /> Call Now
      </a>
      <a
        href="mailto:nextgearmotors1@gmail.com"
        class="flex-1 inline-flex items-center justify-center gap-2 rounded-2xl py-2 px-3 min-h-11 text-sm font-semibold leading-6 font-sans focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-raw-sienna-600 border border-zinc-300 text-zinc-900 hover:border-raw-sienna-600 hover:text-raw-sienna-700 bg-white"
      >
        <.icon name="hero-envelope" class="h-4 w-4" /> Send Email
      </a>
    </div>
  </div>
</article>
