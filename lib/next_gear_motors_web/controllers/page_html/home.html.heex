<section class="relative h-[92svh] max-h-[900px] min-h-[560px] bg-zinc-950 text-white overflow-hidden">
  <div aria-hidden="true" class="absolute inset-0 overflow-hidden">
    <img
      :for={vehicle <- Enum.take(@featured_vehicles, 1)}
      :if={cover = Enum.at(vehicle.covers, 0)}
      src={Cover.url(cover)}
      alt=""
      class="h-full w-full scale-125 object-cover object-center blur-2xl brightness-[0.55] saturate-150"
      loading="eager"
      fetchpriority="low"
    />
  </div>
  <.carousel
    :if={@featured_vehicles != []}
    id="hero-stock"
    size="extra_large"
    padding="extra_large"
    overlay="dark"
    autoplay
    autoplay_interval={6000}
    indicator
    control={false}
    class="relative h-full [&_.slide]:h-full [&_.slide]:bg-transparent"
  >
    <:slide
      :for={vehicle <- @featured_vehicles}
      navigate={~p"/vehicles/#{vehicle}"}
      image={
        vehicle |> Map.get(:covers, []) |> List.first() |> then(fn c -> c && Cover.url(c) end)
      }
      image_class="h-[92svh] max-h-[900px] min-h-[560px] w-full object-cover object-center opacity-90"
      content_position="end"
      wrapper_class="max-w-7xl px-4 pt-24 pb-40"
    />
  </.carousel>
  <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-zinc-950 via-zinc-950/20 to-transparent">
  </div>
  <article class="absolute inset-x-0 bottom-0">
    <div class="mx-auto max-w-7xl px-4 pt-40 pb-16">
      <p class="font-sans text-xs font-bold uppercase tracking-[0.18em] text-raw-sienna-300 text-balance">
        Dublin's independent home for quality used cars
      </p>
      <h1 class="mt-3 max-w-2xl font-display text-4xl md:text-6xl font-bold uppercase">
        Your next car is already here.
      </h1>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:flex sm:flex-row pointer-events-auto max-w-md sm:max-w-none">
        <.link
          :for={{vehicle, idx} <- Enum.with_index(@featured_vehicles, 1)}
          navigate={~p"/vehicles/#{vehicle}"}
          class={["col-span-2 sm:col-span-1", idx != 1 && "hidden"]}
          data-hero-vehicle={idx}
        >
          <.button
            preset={:gradient}
            class="w-full sm:w-auto px-8 py-3 text-base font-bold text-white"
          >
            View this car
          </.button>
        </.link>
        <.link href={~p"/vehicles"}>
          <.button
            preset={:semi_transparent}
            class="w-full sm:w-auto px-6 py-3 text-base font-bold border-white !text-white hover:!text-white hover:border-white bg-white/10"
          >
            Browse the Stock
          </.button>
        </.link>
        <a
          href="tel:+3530857655578"
          class="inline-flex items-center justify-center gap-2 rounded-2xl py-2 px-6 min-h-11 text-base font-bold leading-6 font-sans border border-white text-white bg-white/10 hover:border-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          <.icon name="hero-phone" class="h-4 w-4" /> Call Now
        </a>
      </div>
    </div>
  </article>
</section>

<section :if={@featured_vehicles != []} class="mx-auto max-w-7xl px-4 py-16">
  <div class="flex flex-row items-end justify-between gap-4">
    <div>
      <p class="font-sans text-xs font-bold uppercase tracking-[0.18em] text-raw-sienna-700">
        In stock now
      </p>
      <h2 class="mt-2 font-display text-3xl md:text-4xl font-bold uppercase text-zinc-950">
        On the forecourt
      </h2>
    </div>
    <.link
      href={~p"/vehicles"}
      class="font-sans text-sm font-semibold text-raw-sienna-700 hover:underline shrink-0"
    >
      View all →
    </.link>
  </div>
  <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <.link
      :for={vehicle <- @featured_vehicles}
      navigate={~p"/vehicles/#{vehicle}"}
      title={"More Details - #{vehicle.name}"}
      class="group overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-card transition hover:border-raw-sienna-400 hover:shadow-lift"
    >
      <div class="aspect-[16/10] w-full overflow-hidden bg-parchment">
        <img
          :if={cover = Enum.at(vehicle.covers, 0)}
          src={Cover.url(cover)}
          alt={vehicle.name}
          class="h-full w-full object-cover object-center transition duration-500 group-hover:scale-105"
          loading="lazy"
        />
      </div>
      <div class="flex flex-row items-center justify-between gap-4 p-5">
        <div class="min-w-0">
          <h3 class="truncate font-display text-lg font-semibold text-zinc-950">
            {vehicle.name}
          </h3>
          <p class="font-display text-xl font-semibold text-zinc-950">{vehicle.price}</p>
        </div>
        <p class="shrink-0 font-sans text-sm font-semibold text-raw-sienna-700">
          View →
        </p>
      </div>
    </.link>
  </div>
</section>

<section data-animate-down class="bg-white border-y border-zinc-200">
  <article class="mx-auto grid max-w-7xl grid-cols-1 lg:grid-cols-2 gap-10 px-4 py-16 items-center">
    <div>
      <p class="font-sans text-xs font-bold uppercase tracking-[0.18em] text-raw-sienna-700">
        Welcome
      </p>
      <h2 class="mt-3 font-display text-3xl md:text-4xl font-bold uppercase text-zinc-950">
        Welcome to NextGear Motors
      </h2>
      <p class="mt-4 font-sans text-zinc-600 leading-7">
        We are an independent dealership in Dublin with one simple focus: matching you with a car you will love at a price that makes sense.
      </p>
      <p class="mt-4 font-sans text-zinc-600 leading-7">
        From first browse to final handover, plus sourcing and trade-ins, <.link
          class="text-raw-sienna-700 font-semibold hover:underline"
          href={~p"/contact"}
        >talk to us</.link>.
      </p>
    </div>
    <img
      src={~p"/images/stock/tiguan-side.webp"}
      alt="Volkswagen Tiguan R-Line stock at NextGear Motors"
      class="h-80 w-full rounded-2xl object-cover object-center shadow-lift"
      loading="lazy"
    />
  </article>
</section>

<section class="mx-auto max-w-7xl px-4 py-16">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <article
      data-animate-down
      class="rounded-2xl border border-zinc-200 bg-white p-8 shadow-card"
    >
      <p class="font-sans text-xs font-bold uppercase tracking-[0.18em] text-raw-sienna-700">
        Finance
      </p>
      <h2 class="mt-3 font-display text-2xl md:text-3xl font-bold uppercase text-zinc-950">
        Need finance?
      </h2>
      <p class="mt-3 font-sans text-zinc-600 leading-7">
        Tell us your budget and we will point you at sensible next steps. Enquiries are handled through our contact page.
      </p>
      <div class="mt-6">
        <.link href={~p"/contact"}>
          <.button preset={:primary}>Apply for Finance</.button>
        </.link>
      </div>
    </article>
    <article
      data-animate-down
      class="rounded-2xl border border-zinc-200 bg-white p-8 shadow-card"
    >
      <p class="font-sans text-xs font-bold uppercase tracking-[0.18em] text-raw-sienna-700">
        Sourcing
      </p>
      <h2 class="mt-3 font-display text-2xl md:text-3xl font-bold uppercase text-zinc-950">
        Can't find it? We'll find it.
      </h2>
      <p class="mt-3 font-sans text-zinc-600 leading-7">
        Tell us the make, model and must haves and we will use our trade contacts to track it down. Enquiries are handled through our contact page.
      </p>
      <div class="mt-6">
        <.link href={~p"/contact"}>
          <.button preset={:primary}>Ask About Sourcing</.button>
        </.link>
      </div>
    </article>
  </div>
</section>

<section data-animate-down class="bg-parchment border-y border-zinc-200">
  <article class="mx-auto max-w-7xl px-4 py-16">
    <p class="text-center font-sans text-xs font-bold uppercase tracking-[0.18em] text-raw-sienna-700">
      Why NextGear
    </p>
    <h2 class="mt-3 text-center font-display text-3xl md:text-4xl font-bold uppercase text-zinc-950">
      Buying here is straightforward
    </h2>
    <p class="mt-3 text-center font-sans text-zinc-600">
      Three reasons drivers across Dublin come back to us.
    </p>
    <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-card">
        <.icon name="hero-magnifying-glass" class="h-7 w-7 text-raw-sienna-600" />
        <h3 class="mt-4 font-display text-lg font-semibold text-zinc-950">
          Inspected before it is listed
        </h3>
        <p class="mt-2 font-sans text-sm leading-6 text-zinc-700">
          Every car is checked over and honestly described, so the car you come to see is the car you read about.
        </p>
      </div>
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-card">
        <.icon name="hero-arrows-right-left" class="h-7 w-7 text-raw-sienna-600" />
        <h3 class="mt-4 font-display text-lg font-semibold text-zinc-950">
          Trade ins and sourcing
        </h3>
        <p class="mt-2 font-sans text-sm leading-6 text-zinc-700">
          Part exchange your current car or ask us to track down a specific make and model through our trade contacts.
        </p>
      </div>
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-card">
        <.icon name="hero-calendar-days" class="h-7 w-7 text-raw-sienna-600" />
        <h3 class="mt-4 font-display text-lg font-semibold text-zinc-950">
          Call or email us
        </h3>
        <p class="mt-2 font-sans text-sm leading-6 text-zinc-700">
          Call or message the team with questions, and we will have the car ready when you arrive.
        </p>
      </div>
    </div>
  </article>
</section>

<section class="mx-auto max-w-7xl px-4 py-16">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <.link
      href={~p"/vehicles"}
      data-animate-right
      class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-card transition hover:border-raw-sienna-400 hover:shadow-lift"
    >
      <span class="flex flex-row items-center gap-3">
        <.icon name="hero-shopping-cart" class="h-6 w-6 text-raw-sienna-600" />
        <span class="font-display text-lg font-semibold text-zinc-950">
          Browse the stock
        </span>
      </span>
      <span class="mt-2 block font-sans text-sm text-zinc-600">Quality used cars, 4x4s and vans</span>
    </.link>
    <.link
      href={~p"/users/register"}
      data-animate-right
      class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-card transition hover:border-raw-sienna-400 hover:shadow-lift"
    >
      <span class="flex flex-row items-center gap-3">
        <.icon name="hero-user-plus" class="h-6 w-6 text-raw-sienna-600" />
        <span class="font-display text-lg font-semibold text-zinc-950">
          Create your account
        </span>
      </span>
      <span class="mt-2 block font-sans text-sm text-zinc-600">
        Save time when you contact us
      </span>
    </.link>
    <.link
      href={~p"/contact"}
      data-animate-right
      class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-card transition hover:border-raw-sienna-400 hover:shadow-lift"
    >
      <span class="flex flex-row items-center gap-3">
        <.icon name="hero-chat-bubble-bottom-center-text" class="h-6 w-6 text-raw-sienna-600" />
        <span class="font-display text-lg font-semibold text-zinc-950">
          Talk to the team
        </span>
      </span>
      <span class="mt-2 block font-sans text-sm text-zinc-600">
        Questions on price, history or finance
      </span>
    </.link>
  </div>
</section>
