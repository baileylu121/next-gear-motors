<section class="border-b border-zinc-200 bg-cream">
  <article class="mx-auto max-w-7xl px-4 py-12">
    <p class="font-sans text-xs font-bold uppercase tracking-[0.18em] text-raw-sienna-700">
      Reservation
    </p>
    <h1 class="mt-2 font-display text-3xl md:text-4xl font-bold uppercase text-zinc-950">
      Reservation -
      <.link class="hover:underline" patch={~p"/vehicles/#{@vehicle}"}>{@vehicle.name}</.link>
    </h1>
    <p class="mt-2 font-sans text-zinc-600">
      A reservation for "<.link
        class="hover:underline font-semibold text-raw-sienna-700"
        patch={~p"/vehicles/#{@vehicle}"}
      >{@vehicle.name}</.link>" created by {@owner.email}
    </p>
    <div class="mt-4">
      <.link patch={~p"/reservations/#{@reservation}/show/edit"} phx-click={JS.push_focus()}>
        <.button>Edit Reservation</.button>
      </.link>
    </div>
  </article>
</section>

<div class="mx-auto max-w-7xl px-4">
  <article
    class="mx-auto flex flex-col items-center hidden transform-gpu"
    phx-mounted={
      JS.show(
        transition:
          {"ease-out duration-700", "opacity-0 translate-y-4", "opacity-100 translate-y-0"},
        display: "flex"
      )
    }
  >
    <section class="py-8 w-full max-w-4xl">
      <.list>
        <:title>
          Information
        </:title>
        <:item title="Vehicle">
          <p class="capitalize">
            <.link class="hover:underline" patch={~p"/vehicles/#{@vehicle}"}>{@vehicle.name}</.link>
          </p>
        </:item>
        <:item title="Owner">{@owner.email}</:item>
        <:item title="Status">
          <.status mode={@reservation.status} />
        </:item>
        <:item title="Planned Meeting Time">
          <humanize-date>{@reservation.planned_meeting_time}</humanize-date>
        </:item>
      </.list>

      <.live_component
        module={NextGearMotorsWeb.ReservationLive.MessagesComponent}
        id={@reservation.id}
        title={@page_title}
        action={@live_action}
        current_user={@current_user}
        reservation={@reservation}
        message_id={@message_id}
        patch={~p"/reservations/#{@reservation}"}
      />

      <.back navigate={~p"/reservations"}>Back to reservations</.back>
    </section>
  </article>
</div>

<.modal
  :if={@live_action == :edit}
  id="reservation-modal"
  show
  on_cancel={JS.patch(~p"/reservations/#{@reservation}")}
>
  <.live_component
    module={NextGearMotorsWeb.ReservationLive.FormComponent}
    id={@reservation.id}
    title={@page_title}
    action={@live_action}
    reservation={@reservation}
    current_user={@current_user}
    vehicle={@vehicle}
    patch={~p"/reservations/#{@reservation}"}
  />
</.modal>
